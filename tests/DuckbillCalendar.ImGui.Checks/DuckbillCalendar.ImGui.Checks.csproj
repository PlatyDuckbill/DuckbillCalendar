    <Compile Include="../../src/DuckbillCalendar.Plugin/UI/NotificationPanels.cs" Link="NotificationPanels.cs" />
    <Compile Include="../../src/DuckbillCalendar.Plugin/UI/NotificationViews.cs" Link="NotificationViews.cs" />
    <Compile Include="../../src/DuckbillCalendar.Plugin/UI/WeeklyRaidPlanner.cs" Link="WeeklyRaidPlanner.cs" />
