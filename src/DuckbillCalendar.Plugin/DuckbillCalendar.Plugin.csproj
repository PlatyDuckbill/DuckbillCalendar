<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>DuckbillCalendar</AssemblyName>
    <RootNamespace>DuckbillCalendar.Plugin</RootNamespace>
    <Version>0.1.0.0</Version>
    <Author>PlatyDuckbill</Author>
    <Name>DuckbillCalendar</Name>
    <Punchline>한국 서비스 일정과 개인 이용권을 한 달력에.</Punchline>
    <Description>한국 서비스 일정 캘린더 개발판. /dbcal 또는 /duckbillcalendar. 공식 이벤트 저장본을 포함하며 원격 갱신을 선택할 수 있습니다. 개인 일정·이용권은 로컬에 저장합니다.</Description>
    <RepoUrl>https://github.com/PlatyDuckbill/DuckbillCalendar</RepoUrl>
    <Tags>calendar;events;한국어</Tags>
    <DalamudApiLevel>15</DalamudApiLevel>
    <ApplicableVersion>any</ApplicableVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DuckbillCalendar.Core/DuckbillCalendar.Core.csproj" />
    <ProjectReference Include="../DuckbillCalendar.Infrastructure/DuckbillCalendar.Infrastructure.csproj" />
    <EmbeddedResource Include="../../data/contracts/v2/revisions/000001.json" LogicalName="DuckbillCalendar.ExampleFeed" />
    <EmbeddedResource Include="../../data/live/kr-events.snapshot.json" LogicalName="DuckbillCalendar.OfficialSnapshot" />
  </ItemGroup>
  <Target Name="CheckCalendarReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(DalamudLibPath)' == '' or !Exists('$(DalamudLibPath)/Dalamud.dll')" Text="Set DALAMUD_HOME or -p:DalamudLibPath to one inspected complete API 15 reference distribution." />
    <GetAssemblyIdentity AssemblyFiles="$(DalamudLibPath)/Dalamud.dll"><Output TaskParameter="Assemblies" ItemName="_CalendarReferenceIdentity" /></GetAssemblyIdentity>
    <Error Condition="$([System.Version]::Parse('%(_CalendarReferenceIdentity.Version)').Major) != 15" Text="DuckbillCalendar requires Dalamud API 15 references." />
  </Target>
</Project>
